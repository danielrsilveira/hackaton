# Opcional: copie para .env para sobrescrever os defaults. Valores fictícios, apenas para dev local.
WEB_PORT=4200
API_PORT=8080
DB_PORT_HOST=5433
DB_NAME=sisgares
DB_USER=sisgares
DB_PASSWORD=sisgares_dev
SPRING_PROFILES_ACTIVE=local,seed

# Autenticação. Padrão: simulado (seletor de usuário; a API só sobe assim com o profile "local").
# Para testar o login real com Amazon Cognito (valores da saída da stack infra/cognito.yaml, sem segredos):
# AUTH_MODO=cognito
# AUTH_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# AUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_DOMAIN=https://sisgares-xxxx.auth.us-east-1.amazoncognito.com
